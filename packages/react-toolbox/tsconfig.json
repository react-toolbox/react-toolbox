{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["react", "react-dom"]
  },
  "include": ["components/**/*.ts", "components/**/*.tsx", "tests/types/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
