  "author": {
    "email": "javier.velasco86@gmail.com",
    "name": "Javier Velasco Arjona",
    "url": "http://javivelasco.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-toolbox/react-toolbox.git",
    "directory": "packages/react-toolbox"
  },
  "bugs": {
    "email": "issues@react-toolbox.io",
    "url": "https://github.com/react-toolbox/react-toolbox/issues"
  },
  "keywords": [
    "components",
    "material design",
    "react",
    "react-component",
    "toolkit"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-styles.mjs",
    "dev": "tsdown --watch src --on-success \"node scripts/build-styles.mjs && node scripts/build-registry.mjs && node scripts/build-api-docs.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm --workspace-root exec playwright test packages/react-toolbox/tests/browser",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:footprint",
    "lint": "biome lint . && pnpm lint:tailwind",
    "lint:tailwind": "node scripts/lint-tailwind.mjs",
    "format": "biome format --write .",
    "registry:build": "node scripts/build-registry.mjs",
    "test:registry:install": "node scripts/smoke-registry.mjs",
    "test:footprint": "node scripts/measure-footprint.mjs --check",
    "api:build": "node scripts/build-api-docs.mjs",
    "release:snapshot": "node scripts/release-registry.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
