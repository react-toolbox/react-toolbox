    "build": "tsdown && node scripts/build-styles.mjs",
    "dev": "tsdown --watch components --no-clean --on-success \"node scripts/build-styles.mjs && node scripts/build-registry.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:styles": "node scripts/verify-styles.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:styles && pnpm test:registry",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:serve": "node scripts/serve-registry.mjs",
    "test:registry": "node scripts/verify-registry.mjs",
    "test:registry:install": "node scripts/smoke-registry.mjs"
