{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "biome.json",
    ".nvmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "react-toolbox#dev": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "@react-toolbox/docs#dev": {
      "dependsOn": [
        "^build"
      ],
      "with": [
        "react-toolbox#dev"
      ],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/releases/*.md"
      ],
      "outputs": []
    },
    "registry:build": {
      "inputs": [
        "src/**",
        "scripts/build-registry.mjs",
        "registry.config.mjs",
        "package.json",
        "LICENSE"
      ],
      "env": [
        "REGISTRY_ORIGIN"
      ],
      "outputs": [
        "registry.json",
        "registry/public/**",
        "registry/data.json"
      ]
    },
    "react-toolbox#build": {
      "dependsOn": [
        "registry:build",
        "api:build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "api:build": {
      "inputs": [
        "src/**",
        "scripts/build-api-docs.mjs",
        "package.json"
      ],
      "outputs": [
        "registry/api.json"
      ]
    }
  }
}
