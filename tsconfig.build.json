{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "components",
    "outDir": "dist"
  },
  "include": ["components/**/*.ts", "components/**/*.tsx"],
  "exclude": ["components/**/__tests__/**", "node_modules", "dist"]
}
