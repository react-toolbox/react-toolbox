{
  "name": "react-toolbox-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:library": "turbo run build --filter=react-toolbox",
    "start": "pnpm docs:start",
    "check": "biome lint package.json turbo.json biome.json playwright.config.js && turbo run check",
    "lint": "biome lint . && pnpm lint:tailwind",
    "lint:tailwind": "pnpm --filter react-toolbox lint:tailwind",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "pnpm --filter react-toolbox test:watch",
    "test:browser": "playwright test",
    "registry:build": "turbo run registry:build",
    "test:registry:install": "pnpm --filter react-toolbox test:registry:install",
    "docs:dev": "turbo run dev --filter=@react-toolbox/docs",
    "docs:build": "turbo run build --filter=@react-toolbox/docs",
    "docs:start": "pnpm --filter @react-toolbox/docs start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "turbo": "^2.11.7"
  }
}
